                                    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Invokes units validation workflow to validate invoice unit values against configured subproduct mappings and identify invalid unit combinations." Code="Try&#xA;&#xA;    Dim isUnitsValid As Boolean = True&#xA;&#xA;    Dim SpecialDecimalSubProduct As String = &quot;Reconciliation of Returns (per Hour)&quot;&#xA;&#xA;&#xA;    For Each row As DataRow In Input_CountryDT.Rows&#xA;&#xA;        Dim rowNum As Integer = Input_CountryDT.Rows.IndexOf(row) + 2&#xA;&#xA;        Dim subProduct As String = If(IsDBNull(row(&quot;SUB-PRODUCT&quot;)),&#xA;                                      &quot;&quot;,&#xA;                                      row(&quot;SUB-PRODUCT&quot;).ToString.Trim)&#xA;&#xA;        Dim unitsText As String = If(IsDBNull(row(&quot;Units&quot;)),&#xA;                                     &quot;&quot;,&#xA;                                     row(&quot;Units&quot;).ToString.Trim)&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Blank / NULL / N/A Validation&#xA;        '========================================&#xA;&#xA;        If String.IsNullOrWhiteSpace(unitsText) OrElse&#xA;           unitsText.Equals(&quot;N/A&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;&#xA;            isUnitsValid = False&#xA;&#xA;            dtValidationErrors.Rows.Add(&#xA;                CurrentItem,&#xA;                rowNum,&#xA;                &quot;Units&quot;,&#xA;                unitsText,&#xA;                &quot;Units value is blank or N/A&quot;&#xA;            )&#xA;&#xA;            Continue For&#xA;&#xA;        End If&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Reject formatted numbers (Price values)&#xA;        ' Example: 5,028.46&#xA;        '========================================&#xA;&#xA;        If unitsText.Contains(&quot;,&quot;) Then&#xA;&#xA;            isUnitsValid = False&#xA;&#xA;            dtValidationErrors.Rows.Add(&#xA;                CurrentItem,&#xA;                rowNum,&#xA;                &quot;Units&quot;,&#xA;                unitsText,&#xA;                &quot;Units contains comma formatting and appears to be a price value&quot;&#xA;            )&#xA;&#xA;            Continue For&#xA;&#xA;        End If&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Numeric Format Validation&#xA;        '========================================&#xA;&#xA;        Dim unitValue As Decimal&#xA;&#xA;        If Not Decimal.TryParse(unitsText,&#xA;                                Globalization.NumberStyles.AllowDecimalPoint Or&#xA;                                Globalization.NumberStyles.AllowLeadingSign,&#xA;                                Globalization.CultureInfo.InvariantCulture,&#xA;                                unitValue) Then&#xA;&#xA;&#xA;            isUnitsValid = False&#xA;&#xA;            dtValidationErrors.Rows.Add(&#xA;                CurrentItem,&#xA;                rowNum,&#xA;                &quot;Units&quot;,&#xA;                unitsText,&#xA;                &quot;Units value is not numeric&quot;&#xA;            )&#xA;&#xA;            Continue For&#xA;&#xA;        End If&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Zero Validation&#xA;        '========================================&#xA;&#xA;        If unitValue = 0 Then&#xA;&#xA;            isUnitsValid = False&#xA;&#xA;            dtValidationErrors.Rows.Add(&#xA;                CurrentItem,&#xA;                rowNum,&#xA;                &quot;Units&quot;,&#xA;                unitsText,&#xA;                &quot;Units value cannot be zero&quot;&#xA;            )&#xA;&#xA;            Continue For&#xA;&#xA;        End If&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Remove decimal zero formatting&#xA;        ' Example:&#xA;        ' 8.0  -&gt; treated as 8&#xA;        ' 70.00 -&gt; treated as 70&#xA;        '========================================&#xA;&#xA;        Dim decimalPart As Decimal = Math.Abs(unitValue - Math.Truncate(unitValue))&#xA;&#xA;        Dim isWholeNumber As Boolean = (decimalPart = 0)&#xA;&#xA;        Dim hasActualDecimal As Boolean = Not isWholeNumber&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Freight Validation&#xA;        ' Must have actual decimal values&#xA;        ' Example:&#xA;        ' 123.45  PASS&#xA;        ' 123     FAIL&#xA;        ' 123.0   FAIL&#xA;        '========================================&#xA;&#xA;        If FreightSubProducts.Contains(subProduct) Then&#xA;&#xA;&#xA;            If Not hasActualDecimal Then&#xA;&#xA;                isUnitsValid = False&#xA;&#xA;                dtValidationErrors.Rows.Add(&#xA;                    CurrentItem,&#xA;                    rowNum,&#xA;                    &quot;Units&quot;,&#xA;                    unitsText,&#xA;                    &quot;Freight sub-products require decimal values&quot;&#xA;                )&#xA;&#xA;            End If&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Labeling Validation&#xA;        ' Whole numbers only&#xA;        '========================================&#xA;&#xA;        ElseIf LabelingSubProducts.Contains(subProduct) Then&#xA;&#xA;&#xA;            If Not isWholeNumber Then&#xA;&#xA;                isUnitsValid = False&#xA;&#xA;                dtValidationErrors.Rows.Add(&#xA;                    CurrentItem,&#xA;                    rowNum,&#xA;                    &quot;Units&quot;,&#xA;                    unitsText,&#xA;                    &quot;Labeling sub-products require whole numbers only&quot;&#xA;                )&#xA;&#xA;            End If&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Reconciliation of Returns Exception&#xA;        ' Allows decimal + whole numbers&#xA;        '========================================&#xA;&#xA;        ElseIf subProduct.Equals(SpecialDecimalSubProduct,&#xA;                                 StringComparison.OrdinalIgnoreCase) Then&#xA;&#xA;&#xA;            'Both formats allowed&#xA;            'No validation required&#xA;&#xA;&#xA;&#xA;        '========================================&#xA;        ' Default Validation&#xA;        ' Whole numbers only&#xA;        '========================================&#xA;&#xA;        Else&#xA;&#xA;&#xA;            If Not isWholeNumber Then&#xA;&#xA;                isUnitsValid = False&#xA;&#xA;                dtValidationErrors.Rows.Add(&#xA;                    CurrentItem,&#xA;                    rowNum,&#xA;                    &quot;Units&quot;,&#xA;                    unitsText,&#xA;                    &quot;Units should be a whole number for this sub-product&quot;&#xA;                )&#xA;&#xA;            End If&#xA;&#xA;&#xA;        End If&#xA;&#xA;&#xA;    Next&#xA;&#xA;&#xA;    UnitsValidationStatus = If(isUnitsValid, &quot;Pass&quot;, &quot;Fail&quot;)&#xA;&#xA;&#xA;&#xA;Catch ex As Exception&#xA;&#xA;&#xA;    UnitsValidationStatus = &quot;Fail&quot;&#xA;&#xA;    Throw New Exception(&#xA;        &quot;Units validation failed for country: &quot; &amp;&#xA;        CurrentItem &amp;&#xA;        &quot;. Error: &quot; &amp;&#xA;        ex.Message,&#xA;        ex&#xA;    )&#xA;&#xA;&#xA;End Try" DisplayName="Code - To Validate Units Column" sap:VirtualizedContainerService.HintSize="434,222" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
